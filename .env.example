# CoinKrazy.com Environment Configuration

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Local Development (Docker)
DATABASE_URL=postgresql://coinkrazy:coinkrazy_dev_password@localhost:5432/coinkrazy_db

# Production (Neon)
# DATABASE_URL=postgresql://username:password@hostname:5432/database?sslmode=require

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
VITE_APP_NAME=CoinKrazy
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001
NODE_ENV=development
DEBUG=false
PORT=3001
HOST=0.0.0.0

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET=coinkrazy_jwt_secret_key_change_in_production
SESSION_SECRET=coinkrazy_session_secret_change_in_production

# ============================================================================
# EMAIL SERVICE (Gmail SMTP for notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@coinkrazy.com

# ============================================================================
# PAYMENT PROCESSING - STRIPE (Deposits & Gold Coin Purchases)
# ============================================================================
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_live_your_webhook_secret

# ============================================================================
# PAYMENT PROCESSING - PAYPAL (Deposits)
# ============================================================================
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox  # or live

# ============================================================================
# PAYMENT PROCESSING - SQUARE (Deposits & Redemptions)
# ============================================================================
SQUARE_ACCESS_TOKEN=sq_live_your_access_token
SQUARE_APPLICATION_ID=sq_app_your_app_id
SQUARE_LOCATION_ID=your_location_id
SQUARE_ENVIRONMENT=production  # or sandbox

# ============================================================================
# PAYMENT PROCESSING - CASHAPP (Redemptions Only)
# ============================================================================
CASHAPP_API_KEY=ca_api_your_api_key
CASHAPP_CLIENT_ID=ca_client_your_client_id
CASHAPP_ENVIRONMENT=production  # or sandbox

# ============================================================================
# ACH / BANK TRANSFER PROCESSING (Redemptions)
# ============================================================================
# Dwolla for ACH processing
DWOLLA_TOKEN=prod_your_dwolla_token
DWOLLA_FUNDING_SOURCE=your_funding_source
DWOLLA_ENVIRONMENT=production  # or sandbox

# Alternative: Moov.io for ACH
MOOV_ACCESS_TOKEN=your_moov_access_token
MOOV_ACCOUNT_ID=your_moov_account_id
MOOV_ENVIRONMENT=production  # or sandbox

# ============================================================================
# EXTERNAL GAME PROVIDERS
# ============================================================================
PRAGMATIC_API_KEY=your_pragmatic_api_key
NETENT_API_KEY=your_netent_api_key
MICROGAMING_API_KEY=your_microgaming_api_key

# ============================================================================
# REDIS (For caching and sessions)
# ============================================================================
REDIS_URL=redis://localhost:6379

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn

# ============================================================================
# AWS (Optional - for S3 file uploads, CloudFront CDN)
# ============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=coinkrazy-uploads
AWS_CLOUDFRONT_URL=https://cdn.example.com

# ============================================================================
# PLATFORM SETTINGS
# ============================================================================
# Minimum balance for redemptions
MIN_REDEMPTION_BALANCE_SC=100

# Fee amounts
CASHAPP_WITHDRAWAL_FEE=5
BANK_WITHDRAWAL_FEE=0

# KYC requirements
KYC_REQUIRED_FOR_REDEMPTION=true
KYC_REQUIRED_FOR_DEPOSITS=false

# Fraud detection
FRAUD_DETECTION_ENABLED=true
RISK_THRESHOLD=75
